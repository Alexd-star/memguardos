[Unit]
Description=MemGuardOS Kylin embedding SDK warmup
Documentation=file:/opt/memguardos/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
Environment=PYTHONPATH=/opt/memguardos
ExecStart=/opt/memguardos/scripts/warmup_kylin_sdk.sh
TimeoutStartSec=150

[Install]
WantedBy=graphical-session.target
